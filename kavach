#!/bin/bash
#
# kavach — Unified management CLI for the family-safety pod on shambala.
#
# Usage:
#   kavach build
#   kavach start
#   kavach stop
#   kavach restart
#   kavach status
#   kavach health
#   kavach deploy
#
set -eo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
PROJECT_DIR="$SCRIPT_DIR"
POD_YAML="$PROJECT_DIR/containers/pod.yaml"
POD_NAME="kavach"
AI_ROOT="/ai/kavach"
HOST_WEB_PORT="24278"
ADGUARD_UI_URL="http://localhost:${HOST_WEB_PORT}"
PORTAL_URL="http://localhost:24284"
DOH_ORIGIN_URL="https://localhost:24283/dns-query"
FMD_URL="http://localhost:24280"
TRACCAR_URL="http://localhost:24279"
MDM_URL="http://localhost:24281"
APPROVER_URL="http://localhost:24282"

_R='\033[0m'
_B='\033[1m'
_G='\033[0;32m'
_Y='\033[1;33m'
_C='\033[0;36m'
_RED='\033[0;31m'

_header() {
    echo -e "${_C}${_B}════════════════════════════════════════════════════════════${_R}"
    echo -e "${_C}${_B} $1${_R}"
    echo -e "${_C}${_B}════════════════════════════════════════════════════════════${_R}"
}
_ok()   { echo -e "${_G}   ✅ $1${_R}"; }
_fail() { echo -e "${_RED}   ❌ $1${_R}"; }
_info() { echo -e "${_C}   ℹ️  $1${_R}"; }
_warn() { echo -e "${_Y}   ⚠️  $1${_R}"; }
_die()  { echo ""; _fail "$1"; echo ""; exit 1; }

_ensure_dirs() {
    mkdir -p \
        "$AI_ROOT"/adguard/{conf,work} \
        "$AI_ROOT"/traccar/{conf,data,logs} \
        "$AI_ROOT"/fmd/{conf,db} \
        "$AI_ROOT"/mdm/{postgres,work} \
        "$AI_ROOT"/approver/data \
        "$AI_ROOT"/dashboard \
        "$AI_ROOT"/logs

    if [ ! -f "$AI_ROOT/traccar/conf/traccar.xml" ]; then
        cp "$PROJECT_DIR/config/traccar.xml" "$AI_ROOT/traccar/conf/traccar.xml"
    fi

    if [ ! -f "$AI_ROOT/fmd/conf/config.yml" ]; then
        cp "$PROJECT_DIR/config/fmd-config.yml" "$AI_ROOT/fmd/conf/config.yml"
    fi

    if [ ! -f "$AI_ROOT/approver/data/requests.json" ]; then
        printf '[]\n' > "$AI_ROOT/approver/data/requests.json"
    fi

    cp "$PROJECT_DIR/dashboard/index.html" "$AI_ROOT/dashboard/index.html"
    cp "$PROJECT_DIR/dashboard/default.conf" "$AI_ROOT/dashboard/default.conf"
}

cmd_build() {
    _header "Kavach — Build"
    echo ""
    echo "── Host directories"
    _ensure_dirs
    _ok "$AI_ROOT/adguard/{conf,work}, $AI_ROOT/traccar/{conf,data,logs}, $AI_ROOT/fmd/{conf,db}, $AI_ROOT/mdm/{postgres,work}, $AI_ROOT/approver/data and $AI_ROOT/logs"

    echo ""
    echo "── Pulling AdGuard Home image"
    podman pull docker.io/adguard/adguardhome:latest
    _ok "Image ready: docker.io/adguard/adguardhome:latest"

    echo ""
    echo "── Pulling Traccar image"
    podman pull docker.io/traccar/traccar:latest
    _ok "Image ready: docker.io/traccar/traccar:latest"

    echo ""
    echo "── Pulling FMD Server image"
    podman pull registry.gitlab.com/fmd-foss/fmd-server:0.16.0
    _ok "Image ready: registry.gitlab.com/fmd-foss/fmd-server:0.16.0"

    echo ""
    echo "── Pulling Headwind MDM image"
    podman pull docker.io/headwindmdm/hmdm:0.1.9
    _ok "Image ready: docker.io/headwindmdm/hmdm:0.1.9"

    echo ""
    echo "── Pulling PostgreSQL image"
    podman pull docker.io/library/postgres:16-alpine
    _ok "Image ready: docker.io/library/postgres:16-alpine"

    echo ""
    echo "── Building kavach-approver image"
    podman build -t localhost/kavach-approver:latest "$PROJECT_DIR/approver"
    _ok "Image ready: localhost/kavach-approver:latest"
}

cmd_start() {
    _header "Kavach — Start Pod"
    if podman pod exists "$POD_NAME" 2>/dev/null; then
        _warn "Pod '$POD_NAME' already exists"
        read -p "   Stop and restart? (y/n): " -n 1 -r; echo
        [[ $REPLY =~ ^[Yy]$ ]] || _die "Aborted. Use 'kavach stop' first."
        podman pod stop "$POD_NAME" 2>/dev/null || true
        podman pod rm "$POD_NAME" 2>/dev/null || true
    fi

    _ensure_dirs
    echo ""
    cd "$PROJECT_DIR"
    podman play kube "$POD_YAML" 2>&1 | sed 's/^/   /'
    echo ""
    _info "Waiting 8s for AdGuard to stabilise..."
    sleep 8
    _info "Waiting 8s for Traccar to stabilise..."
    sleep 8
    _info "Waiting 10s for FMD / Headwind / approver to stabilise..."
    sleep 10
    cmd_status
}

cmd_stop() {
    _header "Kavach — Stop Pod"
    if ! podman pod exists "$POD_NAME" 2>/dev/null; then
        _info "Pod '$POD_NAME' is not running"
        exit 0
    fi
    podman pod stop "$POD_NAME"
    podman pod rm "$POD_NAME"
    _ok "Pod stopped and removed (volumes preserved at $AI_ROOT)"
}

cmd_restart() {
    _header "Kavach — Restart"
    if podman pod exists "$POD_NAME" 2>/dev/null; then
        podman pod stop "$POD_NAME" 2>/dev/null || true
        podman pod rm "$POD_NAME" 2>/dev/null || true
    fi
    cmd_start
}

cmd_status() {
    _header "Kavach — Status"
    echo ""
    _info "Pod:"
    podman pod ps --filter "name=$POD_NAME" 2>/dev/null || echo "   (no pod running)"
    echo ""
    _info "Containers:"
    podman ps --filter "pod=$POD_NAME" --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null || echo "   (no containers)"
    echo ""
    _info "Volumes: $AI_ROOT"
    _info "Kavach portal: $PORTAL_URL"
    _info "AdGuard UI: $ADGUARD_UI_URL"
    _info "DoH origin: $DOH_ORIGIN_URL"
    _info "Layer-1 via portal paths: /apps/{adguard,traccar,fmd,mdm,approver}"
}

cmd_health() {
    _header "Kavach — Health Check"
    echo ""

    local fail=0
    _check() {
        if [ "$2" = "ok" ]; then
            _ok "$1"
        else
            _fail "$1 — $2"
            fail=$((fail + 1))
        fi
    }

    local pod_state
    pod_state=$(podman pod inspect "$POD_NAME" --format "{{.State}}" 2>/dev/null || echo "missing")
    [[ "$pod_state" == "Running" ]] && _check "Pod running" "ok" || _check "Pod running" "state=$pod_state"

    local adguard_status
    adguard_status=$(podman inspect "${POD_NAME}-adguard" --format "{{.State.Status}}" 2>/dev/null || echo "missing")
    [[ "$adguard_status" == "running" ]] && _check "AdGuard container" "ok" || _check "AdGuard container" "status=$adguard_status"

    local traccar_status
    traccar_status=$(podman inspect "${POD_NAME}-traccar" --format "{{.State.Status}}" 2>/dev/null || echo "missing")
    [[ "$traccar_status" == "running" ]] && _check "Traccar container" "ok" || _check "Traccar container" "status=$traccar_status"

    local fmd_status
    fmd_status=$(podman inspect "${POD_NAME}-fmd" --format "{{.State.Status}}" 2>/dev/null || echo "missing")
    [[ "$fmd_status" == "running" ]] && _check "FMD container" "ok" || _check "FMD container" "status=$fmd_status"

    local mdm_db_status
    mdm_db_status=$(podman inspect "${POD_NAME}-mdm-db" --format "{{.State.Status}}" 2>/dev/null || echo "missing")
    [[ "$mdm_db_status" == "running" ]] && _check "Headwind DB container" "ok" || _check "Headwind DB container" "status=$mdm_db_status"

    local mdm_status
    mdm_status=$(podman inspect "${POD_NAME}-mdm" --format "{{.State.Status}}" 2>/dev/null || echo "missing")
    [[ "$mdm_status" == "running" ]] && _check "Headwind container" "ok" || _check "Headwind container" "status=$mdm_status"

    local approver_status
    approver_status=$(podman inspect "${POD_NAME}-approver" --format "{{.State.Status}}" 2>/dev/null || echo "missing")
    [[ "$approver_status" == "running" ]] && _check "Approver container" "ok" || _check "Approver container" "status=$approver_status"

    if curl -fsS --max-time 5 "$PORTAL_URL" >/dev/null 2>&1; then
        _check "Kavach portal HTTP" "ok"
    else
        _check "Kavach portal HTTP" "unreachable"
    fi

    if curl -fsS --max-time 5 "$ADGUARD_UI_URL" >/dev/null 2>&1; then
        _check "AdGuard UI HTTP" "ok"
    else
        _check "AdGuard UI HTTP" "unreachable"
    fi

    if curl -fsS --max-time 5 "$TRACCAR_URL" >/dev/null 2>&1; then
        _check "Traccar HTTP" "ok"
    else
        _check "Traccar HTTP" "unreachable"
    fi

    if curl -fsS --max-time 5 "$FMD_URL" >/dev/null 2>&1; then
        _check "FMD HTTP" "ok"
    else
        _check "FMD HTTP" "unreachable"
    fi

    if curl -fsS --max-time 10 "$MDM_URL" >/dev/null 2>&1; then
        _check "Headwind HTTP" "ok"
    else
        _check "Headwind HTTP" "unreachable"
    fi

    if curl -fsS --max-time 5 "$APPROVER_URL/health" >/dev/null 2>&1; then
        _check "Approver HTTP" "ok"
    else
        _check "Approver HTTP" "unreachable"
    fi

    echo ""
    if [ "$fail" -eq 0 ]; then
        _ok "All checks passed"
    else
        _die "Health check failed with $fail issue(s)"
    fi
}

cmd_deploy() {
    _header "Kavach — Full Deploy"
    echo ""
    echo "── 1/4  Build"
    cmd_build
    echo ""
    echo "── 2/4  Stop existing pod"
    if podman pod exists "$POD_NAME" 2>/dev/null; then
        podman pod stop "$POD_NAME" 2>/dev/null || true
        podman pod rm "$POD_NAME" 2>/dev/null || true
        _ok "Existing pod removed"
    else
        _ok "No existing pod"
    fi
    echo ""
    echo "── 3/4  Start pod"
    cmd_start
    echo ""
    echo "── 4/4  Health check"
    cmd_health
}

cmd_help() {
    sed -n '1,20p' "$0"
    echo ""
    echo "Commands:"
    echo "  build"
    echo "  start"
    echo "  stop"
    echo "  restart"
    echo "  status"
    echo "  health"
    echo "  deploy"
}

case "${1:-help}" in
    build) shift; cmd_build "$@" ;;
    start) shift; cmd_start "$@" ;;
    stop) shift; cmd_stop "$@" ;;
    restart) shift; cmd_restart "$@" ;;
    status) shift; cmd_status "$@" ;;
    health) shift; cmd_health "$@" ;;
    deploy) shift; cmd_deploy "$@" ;;
    help|-h|--help) cmd_help ;;
    *)
        _fail "Unknown command: ${1:-}"
        echo ""
        cmd_help
        exit 1
        ;;
esac
